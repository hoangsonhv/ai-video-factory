root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown: trailing whitespace can be a hard line break, so keep it.
[*.md]
trim_trailing_whitespace = false

# Makefiles require real tabs.
[Makefile]
indent_style = tab

# YAML and TOML conventionally use 2-space indentation.
[*.{yml,yaml,toml}]
indent_size = 2
