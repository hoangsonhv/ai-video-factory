# AI Video Factory — example environment configuration.
# Copy to `.env` and adjust. Variables use the AIVF_ prefix and `__` nesting.

# Application
AIVF_APP__NAME=AI Video Factory
AIVF_APP__ENVIRONMENT=dev
AIVF_APP__OUTPUT_DIR=output

# Database (SQLite)
AIVF_DATABASE__PATH=data/factory.db

# Logging
AIVF_LOGGING__LEVEL=INFO
AIVF_LOGGING__CONSOLE=true
AIVF_LOGGING__FILE_ENABLED=true
AIVF_LOGGING__FILE_PATH=logs/aivideo.log
AIVF_LOGGING__MAX_BYTES=10485760
AIVF_LOGGING__BACKUP_COUNT=5
