# AI Video Factory — example environment configuration.
# Copy to `.env` and adjust. Variables use the AIVF_ prefix and `__` nesting.

# Application
AIVF_APP__NAME=AI Video Factory
AIVF_APP__ENVIRONMENT=dev
AIVF_APP__OUTPUT_DIR=output

# Database (SQLite)
AIVF_DATABASE__PATH=data/factory.db

# Logging
AIVF_LOGGING__LEVEL=INFO
AIVF_LOGGING__CONSOLE=true
AIVF_LOGGING__FILE_ENABLED=true
AIVF_LOGGING__FILE_PATH=logs/aivideo.log
AIVF_LOGGING__MAX_BYTES=10485760
AIVF_LOGGING__BACKUP_COUNT=5

# Prompt engine. Root directory that holds prompt templates.
AIVF_PROMPTS__ROOT=prompts

# AI provider (LLM). `provider` selects the adapter; the API key is a secret.
AIVF_PROVIDER__PROVIDER=gemini
# AIVF_PROVIDER__API_KEY=your-api-key-here
AIVF_PROVIDER__MODEL=gemini-3.5-flash
AIVF_PROVIDER__TIMEOUT=30
AIVF_PROVIDER__RETRY_COUNT=3

AIVF_PROVIDER__DIRECTOR_MODEL=gemini-2.5-flash

# Director LLM provider. Leave unset (the default) and the director runs on the
# same provider as the rest of the story pipeline — Gemini, via AIVF_PROVIDER__*
# and AIVF_PROVIDER__DIRECTOR_MODEL. No OpenRouter key is needed.
# Set to `openrouter` only if you deliberately want to route the director there.
# AIVF_DIRECTOR_PROVIDER=openrouter

# OpenRouter — optional, used only when a stage explicitly selects the
# `openrouter` driver. `model` is a fully-qualified route, e.g.
# deepseek/deepseek-chat-v3.
# AIVF_OPENROUTER_API_KEY=your-openrouter-key-here
# AIVF_OPENROUTER_MODEL=deepseek/deepseek-chat-v3
# AIVF_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AIVF_OPENROUTER_TIMEOUT=120
# AIVF_OPENROUTER_RETRY_COUNT=3

# Image provider. Defaults to the free, key-less "pollinations" (MVP).
# Set PROVIDER=gemini_imagen (with an API key + a Gemini image MODEL) to use Google Imagen.
AIVF_IMAGE_PROVIDER__PROVIDER=pollinations
# AIVF_IMAGE_PROVIDER__API_KEY=your-api-key-here
AIVF_IMAGE_PROVIDER__MODEL=flux
AIVF_IMAGE_PROVIDER__TIMEOUT=60
AIVF_IMAGE_PROVIDER__RETRY_COUNT=3

# Speech (TTS) provider. If API key is unset, the LLM provider's key is reused.
AIVF_SPEECH_PROVIDER__PROVIDER=gemini_tts
# AIVF_SPEECH_PROVIDER__API_KEY=your-api-key-here
AIVF_SPEECH_PROVIDER__MODEL=gemini-3.5-flash-preview-tts
AIVF_SPEECH_PROVIDER__VOICE=Kore
AIVF_SPEECH_PROVIDER__TIMEOUT=60
AIVF_SPEECH_PROVIDER__RETRY_COUNT=3

# Transcription (speech-to-text) provider for subtitles. If API key is unset,
# the LLM provider's key is reused.
AIVF_TRANSCRIPTION_PROVIDER__PROVIDER=gemini_transcription
# AIVF_TRANSCRIPTION_PROVIDER__API_KEY=your-api-key-here
AIVF_TRANSCRIPTION_PROVIDER__MODEL=gemini-flash-latest
AIVF_TRANSCRIPTION_PROVIDER__LANGUAGE=vi
AIVF_TRANSCRIPTION_PROVIDER__TIMEOUT=120
AIVF_TRANSCRIPTION_PROVIDER__RETRY_COUNT=3

# Final video composition (ffmpeg). Portrait TikTok defaults.
AIVF_VIDEO__FFMPEG_PATH=ffmpeg
AIVF_VIDEO__WIDTH=1080
AIVF_VIDEO__HEIGHT=1920
AIVF_VIDEO__FPS=30
AIVF_VIDEO__FADE_DURATION=0.5
AIVF_VIDEO__VIDEO_CODEC=libx264
AIVF_VIDEO__AUDIO_CODEC=aac
AIVF_VIDEO__RETRY_COUNT=1

# AI video-generation provider (VIDEO_PROVIDER family).
# Drivers: `mock` (development — renders scene clips with the local ffmpeg
# pipeline, no key needed) and `kling` (Kling AI image-to-video, paid).
# `mock` is the default so the CLI works without credentials.
AIVF_VIDEO_PROVIDER__PROVIDER=mock
AIVF_VIDEO_PROVIDER__MODEL=mock-slideshow
AIVF_VIDEO_PROVIDER__TIMEOUT=300
AIVF_VIDEO_PROVIDER__RETRY_COUNT=1

# Kling AI (used when PROVIDER=kling). API_KEY is KLING_API_KEY, BASE_URL is
# KLING_BASE_URL, MODEL is KLING_MODEL. Kling mints the token from an
# access-key/secret-key pair — put the resulting JWT in API_KEY.
# POLL_INTERVAL/POLL_TIMEOUT bound the wait on one remote render (seconds).
# COST_PER_SECOND is your negotiated rate; it only feeds the manifest's cost
# estimate (0 = unknown), since Kling does not return a price.
# AIVF_VIDEO_PROVIDER__PROVIDER=kling
# AIVF_VIDEO_PROVIDER__MODEL=kling-v1
# AIVF_VIDEO_PROVIDER__API_KEY=
AIVF_VIDEO_PROVIDER__BASE_URL=https://api.klingai.com
AIVF_VIDEO_PROVIDER__POLL_INTERVAL=10
AIVF_VIDEO_PROVIDER__POLL_TIMEOUT=900
AIVF_VIDEO_PROVIDER__COST_PER_SECOND=0
