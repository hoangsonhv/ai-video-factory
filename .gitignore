# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Test & type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Coverage
.coverage
htmlcov/

# Logs
logs/*.log
logs/**/*.log

# Rendered output (keep the folder)
output/*
!output/.gitkeep

# Databases (keep the folder)
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# Local secrets / environment
.env

# Editors / IDEs
.idea/
.vscode/

# OS
.DS_Store
